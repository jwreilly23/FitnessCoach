{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fitnesscoach",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    },
    {
      "name": "fitnesscoach-clean",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8091"],
      "port": 8091
    },
    {
      "name": "fitnesscoach-subfolder",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8092", "--bind", "127.0.0.1", "--directory", ".."],
      "port": 8092
    }
  ]
}
